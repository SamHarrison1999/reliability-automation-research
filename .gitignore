# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

# Disposable quality reports
tmp/quality/

# Local archive and upload material
*.zip
upload/
.ansible/
*.egg-info/

# Node
node_modules/
dist/
coverage/
.pnpm-store/

# Java/Gradle (reserved for a later phase)
.gradle/
build/
target/

# Local infrastructure state
.terraform/
*.tfstate
*.tfstate.*

# Research data: raw participant or experiment data must never be committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
results/generated/*
!results/generated/.gitkeep

# Local logs, recordings and analysis exports
*.log
*.sqlite
*.db
*.mp4
*.wav
*.webm

# Versioned Phase 5 development-analysis fixture only.
# Primary pilot processed data remains ignored.
!data/processed/phase-5/
data/processed/phase-5/*
!data/processed/phase-5/development/
data/processed/phase-5/development/*
!data/processed/phase-5/development/observations.json

# Versioned Phase 5 primary-pilot processed evidence.
# Only deterministic post-collection artifacts are committed.
!data/processed/phase-5/primary/
data/processed/phase-5/primary/*
!data/processed/phase-5/primary/corpus-index.json
!data/processed/phase-5/primary/observations.json
!data/processed/phase-5/primary/provenance.json
!data/processed/phase-5/primary/summary.json
!data/processed/phase-5/primary/descriptive-analysis.json
